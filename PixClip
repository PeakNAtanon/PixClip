#!/usr/bin/env bash
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    TARGET="$(readlink "$SOURCE")"
    [[ "$TARGET" = /* ]] || TARGET="$(dirname "$SOURCE")/$TARGET"
    SOURCE="$TARGET"
done
PROJECT_DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)"
if [[ ! -x "$PROJECT_DIR/pixclip-bin" ]]; then
    echo "Build PixClip first: bash \"$PROJECT_DIR/scripts/build.sh\"" >&2
    exit 1
fi
exec "$PROJECT_DIR/pixclip-bin" "$@"
