#!/usr/bin/env bash
set -euo pipefail

# Resolve this file when it is called through ~/.local/bin/PixClip.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    TARGET="$(readlink "$SOURCE")"
    [[ "$TARGET" = /* ]] || TARGET="$(dirname "$SOURCE")/$TARGET"
    SOURCE="$TARGET"
done
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
    echo "Python 3 was not found: $PYTHON_BIN" >&2
    exit 1
fi

exec "$PYTHON_BIN" "$SCRIPT_DIR/media_toolkit.py" "$@"
